{
  "authoring": {
    "artLimitations": "Four material showcase only. Corrugated scanned iron replaces an iron-block face; emission on photographed rock is authored. Neither was physically calibrated in Minecraft or a headset.",
    "fallback": "Level4 (128-square) of the same chain for ordinary vanilla/Materials consumers.",
    "mips": "2x2 linear-light box for albedo; MaterialImages.average rules for data maps: normal vector renormalization, modal metal codes with first-sample tie break, emission sentinel decoded before averaging.",
    "normal": "Source DirectX X/Y in R/G; source AO in B; source displacement in A.",
    "quantization": "RGBA8 output. Pillow decodes 16-bit RGB PNG to 8-bit RGB; scalar 16-bit maps use rounded division by 257.",
    "sourceResampling": "Poly Haven supplies the 2048-square export; its reconstruction filter is not specified. No source upscaling or geometric resampling here.",
    "specular": "R=255-source perceptual roughness, G=10 dielectric or 230 iron where the source metalness mask >=128, B=0 (no authored porosity/subsurface), A=255 no emission or authored192 for glowstone."
  },
